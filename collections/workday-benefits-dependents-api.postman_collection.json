  "info": {
    "_postman_id": "12ecf3a5-c911-497e-ac47-a1fa56483355",
    "name": "Workday Benefits Benefit Enrollments Dependents API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Workday Benefits API provides RESTful access to employee benefits management capabilities including health insurance enrollments, retirement plans, life insurance, dependent management, time off policies, and benefits administration. The API enables organizations to programmatically manage employee benefit programs, process enrollments, and integrate benefits data with other systems.\n\nContact Support:\n Name: Workday Developer Support",
      "type": "text/plain"
    }
