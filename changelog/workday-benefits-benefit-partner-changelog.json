{
  "openapi": "3.0.1",
  "info": {
    "title": "Changelog for benefitPartner",
    "description": "The benefitPartner service enables third-party benefit providers to import benefit programs into Workday.  Benefit programs can be announcements or other messages the customer wants the software partner to import into Workday. The program can include a title, description, links, and an image and appears as a card on the worker's home screen.\n\nExample: A wellness week event, Benefits and Pay Hub announcement, or hosted meeting for speaker with a financial or insurance advisor.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://<tenantHostname>/benefitPartner/v1"
    }
  ],
